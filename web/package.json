{
  "name": "pikbay-web",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/build-icons.mjs && vite",
    "build": "node scripts/build-icons.mjs && vite build",
    "build:ui-preview": "VITE_DEV_UI=true node scripts/build-icons.mjs && VITE_DEV_UI=true vite build",
    "preview": "vite preview",
    "check": "node scripts/build-icons.mjs && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "lint:guards": "node scripts/check-licenses.mjs && node scripts/check-no-network.mjs && node scripts/check-i18n.mjs && node scripts/check-architecture.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "smol-toml": "1.9.1",
    "uqr": "0.1.3",
    "yaml": "2.9.1"
  }
}
